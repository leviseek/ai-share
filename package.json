{
  "name": "ai-share",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ai:check": "bun run ./src/generate-user-config.ts --check",
    "ai:clean": "bun run ./src/cli/clean.ts",
    "ai:doctor": "bun run ./src/cli/ai-doctor.ts",
    "ai:dry-run": "bun run ./src/generate-user-config.ts --dry-run",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test && bun run memory:check && bun run memory:lint && bun run memory:eval && bun run skill:lint && bun run ai:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ai:bootstrap": "bun run ./src/cli/bootstrap.ts",
    "ai:gen": "bun run ./src/generate-user-config.ts",
    "memory:check": "bun run ./src/cli/memory-privacy-check.ts",
    "memory:eval": "bun run ./src/cli/memory-eval.ts",
    "memory:lint": "bun run ./src/cli/memory-lint.ts",
    "skill:lint": "bun run ./src/cli/skill-lint.ts",
    "provider:check": "bun run ./src/cli/provider-model-check.ts",
    "schema:gen": "bun run ./src/cli/schema-export.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "knowledge:build": "bun run ./src/knowledge/cli.ts build",
    "knowledge:doctor": "bun run ./src/knowledge/cli.ts doctor",
    "knowledge:stats": "bun run ./src/knowledge/cli.ts stats",
    "knowledge:studio": "bun run knowledge:studio:build && bun run ./src/knowledge/studio/server.ts",
    "knowledge:studio:dev": "vite --config vite.config.ts --host 127.0.0.1",
    "knowledge:studio:build": "vite build --config vite.config.ts",
    "knowledge:mcp": "bun run ./src/knowledge/mcp/server.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/bun": "latest",
    "@types/d3": "^7.4.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codegraph-cli": "^0.1.0",
    "eslint": "10.2.1",
    "lucide-react": "^1.23.0",
    "prettier": "latest",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "latest",
    "typescript-eslint": "8.59.0",
    "typescript-language-server": "5.1.3",
    "vite": "^8.1.2"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "luaparse": "^0.3.1"
  }
}
