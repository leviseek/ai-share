{
  "name": "ai-share",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ai:bootstrap": "bun run ./src/cli/bootstrap.ts",
    "ai:clean": "bun run ./src/cli/clean.ts",
    "ai:check": "bun run ./src/cli/ai-check.ts",
    "ai:config": "bun run ./src/cli/ai-config.ts",
    "ai:help": "bun run ./src/cli/ai-help.ts",
    "ai:dry-run": "bun run ./src/generate-user-config.ts --dry-run",
    "ai:explain": "bun run ./src/cli/ai-explain.ts",
    "ai:gen": "bun run ./src/generate-user-config.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test && bun run schema:check && bun run memory:check && bun run memory:lint && bun run memory:eval && bun run skill:lint && bun run ai:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "memory:check": "bun run ./src/cli/memory-privacy-check.ts",
    "memory:eval": "bun run ./src/cli/memory-eval.ts",
    "memory:lint": "bun run ./src/cli/memory-lint.ts",
    "provider:check": "bun run ./src/cli/provider-model-check.ts",
    "schema:check": "bun run ./src/cli/schema-check.ts",
    "schema:gen": "bun run ./src/cli/schema-export.ts",
    "skill:lint": "bun run ./src/cli/skill-lint.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.3.13",
    "eslint": "10.2.1",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.0",
    "typescript-language-server": "5.1.3"
  },
  "packageManager": "bun@1.3.13"
}
