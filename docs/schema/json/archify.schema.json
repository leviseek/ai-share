{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai-share archify.yaml",
  "type": "object",
  "required": [
    "archify"
  ],
  "properties": {
    "archify": {
      "type": "object",
      "required": [
        "repo",
        "skill",
        "ref",
        "enabled"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "description": "Archify GitHub repository slug.",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "skill": {
          "type": "string",
          "description": "Skill directory installed by Archify.",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "ref": {
          "type": "string",
          "description": "Pinned Archify Git revision or safe tag.",
          "minLength": 1,
          "pattern": "^(?:[0-9a-f]{40}|[A-Za-z0-9][A-Za-z0-9._-]{0,63})$"
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether ai-share manages the Archify skill."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
