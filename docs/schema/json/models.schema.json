{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai-share models.yaml",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": [
      "model_name"
    ],
    "properties": {
      "model_name": {
        "type": "string",
        "description": "Upstream model name sent to provider.",
        "minLength": 1
      },
      "reasoning_effort": {
        "type": "string",
        "description": "OpenCode model reasoning effort.",
        "minLength": 1,
        "enum": [
          "low",
          "medium",
          "high"
        ]
      }
    },
    "additionalProperties": false
  },
  "propertyNames": {
    "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
  }
}
