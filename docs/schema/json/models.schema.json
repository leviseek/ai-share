{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai-share models.yaml",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": [
      "model_name"
    ],
    "properties": {
      "model_name": {
        "type": "string",
        "description": "Upstream model name sent to provider.",
        "minLength": 1
      },
      "reasoning_effort": {
        "type": "string",
        "description": "OpenCode model reasoning effort.",
        "minLength": 1,
        "enum": [
          "low",
          "medium",
          "high"
        ]
      },
      "attachment": {
        "type": "boolean",
        "description": "Whether the model supports image/file attachments (multimodal)."
      },
      "modalities": {
        "type": "object",
        "properties": {
          "input": {
            "type": "array",
            "description": "Input modalities (text/audio/image/video/pdf).",
            "items": {
              "type": "string",
              "description": "Input modalities (text/audio/image/video/pdf).",
              "minLength": 1,
              "enum": [
                "text",
                "audio",
                "image",
                "video",
                "pdf"
              ]
            },
            "minItems": 1
          },
          "output": {
            "type": "array",
            "description": "Output modalities (text/audio/image/video/pdf).",
            "items": {
              "type": "string",
              "description": "Output modalities (text/audio/image/video/pdf).",
              "minLength": 1,
              "enum": [
                "text",
                "audio",
                "image",
                "video",
                "pdf"
              ]
            },
            "minItems": 1
          }
        },
        "additionalProperties": false,
        "minProperties": 1
      }
    },
    "additionalProperties": false
  },
  "propertyNames": {
    "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
  }
}
