{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai-share env.yaml",
  "type": "object",
  "properties": {
    "variables": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "description": "Codex .env variable value.",
        "minLength": 1
      },
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      }
    }
  }
}
