{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai-share provider.yaml",
  "type": "object",
  "required": [
    "providers"
  ],
  "properties": {
    "providers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "base_url",
          "api_key",
          "models",
          "default_model"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Human-readable provider name.",
            "minLength": 1
          },
          "base_url": {
            "type": "string",
            "description": "OpenAI-compatible HTTPS base URL.",
            "minLength": 1,
            "pattern": "^https://[^\\s]+$"
          },
          "api_key": {
            "type": "string",
            "description": "Environment variable reference.",
            "minLength": 1,
            "pattern": "^\\$\\{[A-Z_][A-Z0-9_]*\\}$"
          },
          "models": {
            "type": "array",
            "description": "models.yaml model id supported by this provider.",
            "items": {
              "type": "string",
              "description": "models.yaml model id supported by this provider.",
              "minLength": 1,
              "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "default_model": {
            "type": "string",
            "description": "Default models.yaml model id for this provider.",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "native": {
            "type": "boolean",
            "description": "Whether OpenCode provides native support for this provider."
          }
        },
        "additionalProperties": false
      },
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
      }
    }
  },
  "additionalProperties": false
}
