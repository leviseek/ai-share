{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai-share wezterm.yaml",
  "type": "object",
  "required": [
    "shell",
    "color_scheme",
    "font_size",
    "window_background_opacity",
    "maximize_on_startup",
    "scrollback_lines"
  ],
  "properties": {
    "shell": {
      "type": "string",
      "description": "WezTerm shell selection.",
      "minLength": 1,
      "enum": [
        "platform-native",
        "wezterm-default"
      ]
    },
    "color_scheme": {
      "type": "string",
      "description": "WezTerm color scheme selection.",
      "minLength": 1,
      "enum": [
        "catppuccin-mocha",
        "dracula",
        "tokyo-night",
        "wezterm-default"
      ]
    },
    "font_size": {
      "type": "number",
      "description": "WezTerm font size.",
      "enum": [
        11,
        12,
        13
      ]
    },
    "window_background_opacity": {
      "type": "number",
      "description": "WezTerm window background opacity.",
      "enum": [
        0.88,
        0.94,
        1
      ]
    },
    "maximize_on_startup": {
      "type": "boolean",
      "description": "Whether WezTerm starts maximized."
    },
    "scrollback_lines": {
      "type": "number",
      "description": "WezTerm scrollback line count.",
      "enum": [
        10000,
        100000,
        1000000
      ]
    }
  },
  "additionalProperties": false
}
