{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai-share agents.yaml",
  "type": "object",
  "required": [
    "agents"
  ],
  "properties": {
    "agents": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "description",
          "mode",
          "prompt"
        ],
        "properties": {
          "description": {
            "type": "string",
            "description": "Human-facing guidance for when OpenCode should use the agent.",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "description": "models.yaml model id, or a full provider/model reference (e.g. opencode/deepseek-v4-flash-free).",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*(?:/[a-z0-9]+(?:[.-][a-z0-9]+)*)?$"
          },
          "reasoning_effort": {
            "type": "string",
            "description": "OpenCode reasoning effort override.",
            "minLength": 1,
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "mode": {
            "type": "string",
            "description": "OpenCode agent mode.",
            "minLength": 1,
            "enum": [
              "primary",
              "subagent",
              "all"
            ]
          },
          "prompt": {
            "type": "string",
            "description": "Core prompt that defines the agent behavior.",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    }
  },
  "additionalProperties": false
}
