{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai-share global.yaml",
  "type": "object",
  "required": [
    "model",
    "provider"
  ],
  "properties": {
    "model": {
      "type": "string",
      "description": "Default OpenCode model id from models.yaml.",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "provider": {
      "type": "string",
      "description": "Default provider id from provider.yaml.",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "opencode_min_version": {
      "type": "string",
      "description": "Minimum OpenCode CLI version checked by ai:doctor.",
      "minLength": 1,
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    }
  },
  "additionalProperties": false
}
